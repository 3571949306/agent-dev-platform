{
  "name": "agent-dev-platform",
  "version": "2.9.9",
  "description": "Agent Dev Platform - 本地 AI Agent IDE（智能体开发环境）：Coding Agent / 多 Agent 调度 / API 管理 / Computer Use / MCP / 外部 Agent 聚合",
  "main": "main.js",
  "scripts": {
    "start": "node src/server/static.js",
    "electron": "electron .",
    "predist": "npm run prepare-cline-runtime",
    "dist": "electron-builder --win nsis portable --publish never",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test": "node scripts/run-tests.js",
    "smoke": "electron . --smoke",
    "prepare-cline-runtime": "node scripts/prepare-cline-runtime.js",
    "integration-smoke": "npm run prepare-cline-runtime && node scripts/integration-smoke.js",
    "pree2e": "npm run prepare-cline-runtime",
    "e2e": "playwright test",
    "test:real-ai:orchestrator": "node scripts/real-ai-orchestrator-smoke.js",
    "test:real-ai:dry-run": "node scripts/real-ai-orchestrator-smoke.js --dry-run",
    "test:real-ai:new-session": "node scripts/real-ai-new-session.js",
    "test:deterministic-orchestrator": "node scripts/deterministic-orchestrator-smoke.js",
    "test:dynamic-agent": "node scripts/run-tests.js dynamicAgent",
    "test:dynamic-agent:production": "node scripts/run-tests.js dynamicAgentProduction",
    "test:model-router": "node scripts/run-tests.js modelRouter.test",
    "test:model-router:production": "node scripts/run-tests.js modelRouterProduction",
    "test:skill": "node scripts/run-tests.js skill.test",
    "test:skill:production": "node scripts/run-tests.js skillProduction",
    "test:hook": "node scripts/run-tests.js hook.test",
    "test:hook:production": "node scripts/run-tests.js hookProduction",
    "test:workflow": "node scripts/run-tests.js workflow.test",
    "test:workflow:production": "node scripts/run-tests.js workflowProduction",
    "test:generator": "node scripts/run-tests.js generator.test",
    "test:generator:production": "node scripts/run-tests.js generatorProduction",
    "test:architecture": "node scripts/test-architecture.js",
    "test:architecture-policy": "node scripts/run-tests.js architecturePolicy",
    "test:product": "node scripts/run-tests.js product.test",
    "test:product:production": "node scripts/product-production-smoke.js",
    "test:reliability": "node scripts/run-tests.js reliability",
    "test:reliability-closure": "node scripts/run-tests.js reliabilityClosure",
    "test:reliability:production": "node scripts/reliability-production-smoke.js",
    "test:reliability:soak": "node scripts/run-tests.js reliabilitySoak",
    "test:gui": "node scripts/run-tests.js guiWorkbench",
    "test:gui:production": "node scripts/gui-production-smoke.js",
    "test:computer-hardening": "node scripts/run-tests.js computerHardening.test",
    "test:computer-hardening:production": "node scripts/run-tests.js computerHardeningProduction",
    "test:computer-hardening:soak": "node scripts/run-tests.js computerHardeningSoak",
    "test:computer-closure": "node scripts/run-tests.js computerClosure.test",
    "test:computer-closure:production": "node scripts/run-tests.js computerClosureProduction",
    "test:computer-closure:soak": "node scripts/run-tests.js computerClosureSoak",
    "icon": "node scripts/make-icon.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.agentdev.platform",
    "productName": "Agent Dev Platform",
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Agent Dev Platform ${version} portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Dev Platform"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/**/{*.md,*.markdown,LICENSE,CHANGELOG,test,tests,__tests__,docs,example,examples}",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/playwright/**/*.zip",
      "!node_modules/playwright/.local-browsers/**"
    ],
    "afterPack": "./scripts/after-pack-cline-runtime.js"
  }
}
